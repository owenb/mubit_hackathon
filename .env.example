# Paste your OpenAI API key after the equals sign (no spaces required).
# Used only for direct OpenAI baseline calls; Mubit provider setup is separate.
OPENAI_API_KEY=

# Create an Inference key in Mubit > Get started / Mubit keys, then paste it here.
MUBIT_API_KEY=

# Confirm this URL against the project's Connect page.
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
OPENAI_MODEL=gpt-6-luna
